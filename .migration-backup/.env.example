# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/tattoo_record
PGHOST=localhost
PGPORT=5432
PGUSER=user
PGPASSWORD=password
PGDATABASE=tattoo_record

# Authentication
# ⚠️  Use a long random string in production (e.g. openssl rand -hex 64)
JWT_SECRET=tattoo-record-secret-key-change-in-production
SESSION_SECRET=session-secret-key-change-in-production

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Anthropic Configuration (AI auto-tagging + digest)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Voyage AI Configuration (semantic search embeddings)
VOYAGE_API_KEY=your_voyage_api_key

# AI Feature Flags (set to "true" to enable; requires keys above)
AI_AUTOTAG=false
AI_DIGEST=false
AI_SEMANTIC_SEARCH=false

# Client-side AI feature flag (set to "true" to show AI UI)
VITE_AI_ENABLED=false

# Application Configuration
NODE_ENV=development
PORT=5000

# Demo Login
# Set both values to "true" to enable one-click demo buttons on a deployed instance.
# Leave unset/false for a normal production launch. Admin demo login remains dev-only.
DEMO_MODE=false
VITE_DEMO_MODE=false

# WebSocket Configuration
WEBSOCKET_HEARTBEAT_MS=30000

# Story Configuration
STORY_TTL_HOURS=24
